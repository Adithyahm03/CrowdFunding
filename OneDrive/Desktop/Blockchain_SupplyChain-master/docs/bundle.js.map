19 0x206973206E6F74204173736F6369617465642E 0x4f PUSH15 0x6C79204173736F6369617465205368 PUSH10 0x707065722063616E2063 PUSH2 0x6C6C KECCAK256 PUSH21 0x6869732066756E6374696F6E4F6E6C79204173736F PUSH4 0x69617465 KECCAK256 JUMPI PUSH9 0x6F6C6573616C657220 PUSH16 0x72204469737472756275746572206361 PUSH15 0x2063616C6C20746869732066756E63 PUSH21 0x696F6E746869732057686F6C6573616C6572206973 KECCAK256 PUSH15 0x6F74204173736F6369617465642E74 PUSH9 0x697320446973747269 PUSH3 0x757465 PUSH19 0x206973206E6F74204173736F6369617465642E LOG1 PUSH6 0x627A7A723058 KECCAK256 0xcc LOG1 ADDRESS 0xe8 0xbd 0xfc DUP11 PUSH19 0x28AFECC7DF0383C41D2E19913E91F453BD8505 PUSH14 0x54FE83A000290000000000000000 ","source":"pragma solidity >=0.4.25 <0.6.0;\n\n/********************************************** Madicine ******************************************/\n/// @title Madicine\n/// @notice\n/// @dev\ncontract Madicine {\n\n    /// @notice\n    address Owner;\n\n    enum madicineStatus {\n        atcreator,\n        picked4W,\n        picked4D,\n        deliveredatW,\n        deliveredatD,\n        picked4P,\n        deliveredatP\n    }\n\n    // address batchid;\n    bytes32 description;\n    /// @notice\n    bytes32 rawmatriales;\n    /// @notice\n    uint quantity;\n    /// @notice\n    address shipper;\n    /// @notice\n    address manufacturer;\n    /// @notice\n    address wholesaler;\n    /// @notice\n    address distributer;\n    /// @notice\n    address pharma;\n    /// @notice\n    madicineStatus status;\n\n    event ShippmentUpdate(\n        address indexed BatchID,\n        address indexed Shipper,\n        address indexed Receiver,\n        uint TransporterType,\n        uint Status\n    );\n\n    /// @notice\n    /// @dev Create new Madicine Batch by Manufacturer\n    /// @param Manu Manufacturer Ethereum Network Address\n    /// @param Des Description of Madicine Batch\n    /// @param RM RawMatrials for Madicine\n    /// @param Quant Number of units\n    /// @param Shpr Transporter Ethereum Network Address\n    /// @param Rcvr Receiver Ethereum Network Address\n    /// @param RcvrType Receiver Type either Wholesaler(1) or Distributer(2)\n    constructor(\n        address Manu,\n        bytes32 Des,\n        bytes32 RM,\n        uint Quant,\n        address Shpr,\n        address Rcvr,\n        uint RcvrType\n    ) public {\n        Owner = Manu;\n        manufacturer = Manu;\n        description = Des;\n        rawmatriales = RM;\n        quantity = Quant;\n        shipper = Shpr;\n        if(RcvrType == 1) {\n            wholesaler = Rcvr;\n        } else if( RcvrType == 2){\n            distributer = Rcvr;\n        }\n    }\n\n    /// @notice\n    /// @dev Get Madicine Batch basic Details\n    /// @return Madicine Batch Details\n    function getMadicineInfo () public view returns(\n        address Manu,\n        bytes32 Des,\n        bytes32 RM,\n        uint Quant,\n        address Shpr\n    ) {\n        return(\n            manufacturer,\n            description,\n            rawmatriales,\n            quantity,\n            shipper\n        );\n    }\n\n    /// @notice\n    /// @dev Get address Wholesaler, Distributer and Pharma\n    /// @return Address Array\n    function getWDP() public view returns(\n        address[3] memory WDP\n    ) {\n        return (\n            [wholesaler,distributer,pharma]\n        );\n    }\n\n    /// @notice\n    /// @dev Get Madicine Batch Transaction Status\n    /// @return Madicine Transaction Status\n    function getBatchIDStatus() public view returns(\n        uint\n    ) {\n        return uint(status);\n    }\n\n    /// @notice\n    /// @dev Pick Madicine Batch by Associate Transporter\n    /// @param shpr Transporter Ethereum Network Address\n    function pickPackage(\n        address shpr\n    ) public {\n        require(\n            shpr == shipper,\n            \"Only Associate Shipper can call this function\"\n        );\n        require(\n            status == madicineStatus(0),\n            \"Package must be at Supplier.\"\n        );\n\n        if(wholesaler!=address(0x0)){\n            status = madicineStatus(1);\n            emit ShippmentUpdate(address(this),shipper,wholesaler,1,1);\n        }else{\n            status = madicineStatus(2);\n            emit ShippmentUpdate(address(this),shipper,distributer,1,1);\n        }\n    }\n\n    /// @notice\n    /// @dev Received Madicine Batch by Associated Wholesaler or Distributer\n    /// @param Rcvr Wholesaler or Distributer\n    function receivedPackage(\n        address Rcvr\n    ) public\n    returns(uint rcvtype)\n    {\n\n        require(\n            Rcvr == wholesaler || Rcvr == distributer,\n            \"Only Associate Wholesaler or Distrubuter can call this function\"\n        );\n\n        require(\n            uint(status) >= 1,\n            \"Product not picked up yet\"\n        );\n\n        if(Rcvr == wholesaler && status == madicineStatus(1)){\n            status = madicineStatus(3);\n            emit ShippmentUpdate(address(this),shipper,wholesaler,2,3);\n            return 1;\n        } else if(Rcvr == distributer && status == madicineStatus(2)){\n            status = madicineStatus(4);\n            emit ShippmentUpdate(address(this),shipper,distributer,3,4);\n            return 2;\n        }\n    }\n\n    /// @notice\n    /// @dev Update Madicine Batch transaction Status(Pick) in between Wholesaler and Distributer\n    /// @param receiver Distributer Ethereum Network Address\n    /// @param sender Wholesaler Ethereum Network Address\n    function sendWD(\n        address receiver,\n        address sender\n    ) public {\n        require(\n            wholesaler == sender,\n            \"this Wholesaler is not Associated.\"\n        );\n        distributer = receiver;\n        status = madicineStatus(2);\n    }\n\n    /// @notice\n    /// @dev Update Madicine Batch transaction Status(Recieved) in between Wholesaler and Distributer\n    /// @param receiver Distributer\n    function recievedWD(\n        address receiver\n    ) public {\n        require(\n            distributer == receiver,\n            \"This Distributer is not Associated.\"\n        );\n        status = madicineStatus(4);\n    }\n\n    /// @notice\n    /// @dev Update Madicine Batch transaction Status(Pick) in between Distributer and Pharma\n    /// @param receiver Pharma Ethereum Network Address\n    /// @param sender Distributer Ethereum Network Address\n    function sendDP(\n        address receiver,\n        address sender\n    ) public {\n        require(\n            distributer == sender,\n            \"this Distributer is not Associated.\"\n        );\n        pharma = receiver;\n        status = madicineStatus(5);\n    }\n\n    /// @notice\n    /// @dev Update Madicine Batch transaction Status(Recieved) in between Distributer and Pharma\n    /// @param receiver Pharma Ethereum Network Address\n    function recievedDP(\n        address receiver\n    ) public {\n        require(\n            pharma == receiver,\n            \"This Pharma is not Associated.\"\n        );\n        status = madicineStatus(6);\n    }\n}\n","abiDocs":[{"constant":true,"inputs":[],"name":"getWDP","outputs":[{"name":"WDP","type":"address[3]"}],"payable":false,"stateMutability":"view","type":"function","return":"Address Array","notice":"@dev Get address Wholesaler, Distributer and Pharma","signature":"getWDP()","signatureHash":"01a9a23e"},{"constant":true,"inputs":[],"name":"getMadicineInfo","outputs":[{"name":"Manu","type":"address"},{"name":"Des","type":"bytes32"},{"name":"RM","type":"bytes32"},{"name":"Quant","type":"uint256"},{"name":"Shpr","type":"address"}],"payable":false,"stateMutability":"view","type":"function","return":"Madicine Batch Details","notice":"@dev Get Madicine Batch basic Details","signature":"getMadicineInfo()","signatureHash":"1d2aafc8"},{"constant":false,"inputs":[{"name":"receiver","type":"address","description":"Pharma Ethereum Network Address"}],"name":"recievedDP","outputs":[],"payable":false,"stateMutability":"nonpayable","type":"function","notice":"@dev Update Madicine Batch transaction Status(Recieved) in between Distributer and Pharma","signature":"recievedDP(address)","signatureHash":"4175699d"},{"constant":false,"inputs":[{"name":"Rcvr","type":"address","description":"Wholesaler or Distributer"}],"name":"receivedPackage","payable":false,"stateMutability":"nonpayable","type":"function","notice":"@dev Received Madicine Batch by Associated Wholesaler or Distributer","signature":"receivedPackage(address)","signatureHash":"52b99968"},{"constant":false,"inputs":[{"name":"shpr","type":"address","description":"Transporter Ethereum Network Address"}],"name":"pickPackage","outputs":[],"payable":false,"stateMutability":"nonpayable","type":"function","notice":"@dev Pick Madicine Batch by Associate Transporter","signature":"pickPackage(address)","signatureHash":"638e9a3d"},{"constant":false,"inputs":[{"name":"receiver","type":"address","description":"Distributer"}],"name":"recievedWD","outputs":[],"payable":false,"stateMutability":"nonpayable","type":"function","notice":"@dev Update Madicine Batch transaction Status(Recieved) in between Wholesaler and Distributer","signature":"recievedWD(address)","signatureHash":"952565cf"},{"constant":false,"inputs":[{"name":"receiver","type":"address","description":"Pharma Ethereum Network Address"},{"name":"sender","type":"address","description":"Distributer Ethereum Network Address"}],"name":"sendDP","outputs":[],"payable":false,"stateMutability":"nonpayable","type":"function","notice":"@dev Update Madicine Batch transaction Status(Pick) in between Distributer and Pharma","signature":"sendDP(address,address)","signatureHash":"a19ffd60"},{"constant":false,"inputs":[{"name":"receiver","type":"address","description":"Distributer Ethereum Network Address"},{"name":"sender","type":"address","description":"Wholesaler Ethereum Network Address"}],"name":"sendWD","outputs":[],"payable":false,"stateMutability":"nonpayable","type":"function","notice":"@dev Update Madicine Batch transaction Status(Pick) in between Wholesaler and Distributer","signature":"sendWD(address,address)","signatureHash":"bd786835"},{"constant":true,"inputs":[],"name":"getBatchIDStatus","outputs":[{"name":"","type":"uint256"}],"payable":false,"stateMutability":"view","type":"function","return":"Madicine Transaction Status","notice":"@dev Get Madicine Batch Transaction Status","signature":"getBatchIDStatus()","signatureHash":"d2f3fcc7"},{"inputs":[{"name":"Manu","type":"address"},{"name":"Des","type":"bytes32"},{"name":"RM","type":"bytes32"},{"name":"Quant","type":"uint256"},{"name":"Shpr","type":"address"},{"name":"Rcvr","type":"address"},{"name":"RcvrType","type":"uint256"}],"payable":false,"stateMutability":"nonpayable","type":"constructor"},{"anonymous":false,"inputs":[{"indexed":true,"name":"BatchID","type":"address"},{"indexed":true,"name":"Shipper","type":"address"},{"indexed":true,"name":"Receiver","type":"address"},{"indexed":false,"name":"TransporterType","type":"uint256"},{"indexed":false,"name":"Status","type":"uint256"}],"name":"ShippmentUpdate","type":"event","signature":"ShippmentUpdate(address,address,address,uint256,uint256)","signatureHash":"7e89c4b1"}]}


