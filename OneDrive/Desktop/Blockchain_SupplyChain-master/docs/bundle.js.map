       receiver,\n            sender\n        );\n    }\n\n    /// @notice\n    /// @dev Recieved Madicine Batch by Associate Distributer\n    /// @param BatchID Madicine BatchID\n    /// @param Receiver Pharma Ethereum Network Address\n    function recieveDP(\n        address BatchID,\n        address Receiver\n    ) public {\n        require(\n            Receiver == receiver,\n            \"Only Associated receiver can call this function.\"\n        );\n        status = packageStatus(2);\n\n        Madicine(BatchID).recievedDP(\n            Receiver\n        );\n    }\n\n    /// @notice\n    /// @dev Get Madicine Batch Transaction status in between Distributer and Pharma\n    /// @return Transaction status\n    function getBatchIDStatus() public view returns(\n        uint\n    ) {\n        return uint(status);\n    }\n\n}\n","abiDocs":[{"constant":false,"inputs":[{"name":"BatchID","type":"address","description":"Madicine BatchID"},{"name":"Receiver","type":"address","description":"Pharma Ethereum Network Address"}],"name":"recieveDP","outputs":[],"payable":false,"stateMutability":"nonpayable","type":"function","notice":"@dev Recieved Madicine Batch by Associate Distributer","signature":"recieveDP(address,address)","signatureHash":"32a60e00"},{"constant":true,"inputs":[],"name":"getBatchIDStatus","outputs":[{"name":"","type":"uint256"}],"payable":false,"stateMutability":"view","type":"function","return":"Transaction status","notice":"@dev Get Madicine Batch Transaction status in between Distributer and Pharma","signature":"getBatchIDStatus()","signatureHash":"d2f3fcc7"},{"constant":false,"inputs":[{"name":"BatchID","type":"address","description":"Madicine BatchID"},{"name":"Shipper","type":"address","description":"Transporter Ethereum Network Address"}],"name":"pickDP","outputs":[],"payable":false,"stateMutability":"nonpayable","type":"function","notice":"@dev Pick Madicine Batch by Associated Transporter","signature":"pickDP(address,address)","signatureHash":"d39ff0e7"},{"inputs":[{"name":"BatchID","type":"address"},{"name":"Sender","type":"address"},{"name":"Shipper","type":"address"},{"name":"Receiver","type":"address"}],"payable":false,"stateMutability":"nonpayable","type":"constructor"}]}


