FFFFF AND ADDRESS PUSH20 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF AND PUSH32 0x7E89C4B1A4E2B51AAE84EB1F90E8A34CB792ECE5AC5CB63DB4830C891220B28D PUSH1 0x1 DUP1 PUSH1 0x40 MLOAD DUP1 DUP4 DUP2 MSTORE PUSH1 0x20 ADD DUP3 DUP2 MSTORE PUSH1 0x20 ADD SWAP3 POP POP POP PUSH1 0x40 MLOAD DUP1 SWAP2 SUB SWAP1 LOG4 POP JUMP JUMPDEST PUSH1 0x0 DUP1 PUSH1 0x0 DUP1 PUSH1 0x0 DUP1 PUSH1 0x0 PUSH1 0x2 SLOAD PUSH1 0x3 SLOAD PUSH1 0x4 SLOAD PUSH1 0x5 SLOAD PUSH1 0x6 PUSH1 0x0 SWAP1 SLOAD SWAP1 PUSH2 0x100 EXP SWAP1 DIV PUSH20 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF AND PUSH1 0x7 PUSH1 0x0 SWAP1 SLOAD SWAP1 PUSH2 0x100 EXP SWAP1 DIV PUSH20 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF AND PUSH1 0x8 PUSH1 0x0 SWAP1 SLOAD SWAP1 PUSH2 0x100 EXP SWAP1 DIV PUSH20 0xFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFFF AND SWAP7 POP SWAP7 POP SWAP7 POP SWAP7 POP SWAP7 POP SWAP7 POP SWAP7 POP SWAP1 SWAP2 SWAP3 SWAP4 SWAP5 SWAP6 SWAP7 JUMP INVALID 0x4f PUSH15 0x6C79204173736F6369617465205368 PUSH10 0x707065722063616E2063 PUSH2 0x6C6C KECCAK256 PUSH21 0x6869732066756E6374696F6E4F6E6C79204173736F PUSH4 0x69617465 KECCAK256 0x4d PUSH2 0x6E75 PUSH7 0x61637475726572 KECCAK256 PUSH4 0x616E2063 PUSH2 0x6C6C KECCAK256 PUSH21 0x6869732066756E6374696F6EA165627A7A72305820 GASPRICE CREATE2 0xce OR 0xf8 DUP7 0x5f 0xef PUSH4 0x1F268796 KECCAK256 0x25 0x5d 0xaa 0xeb PUSH7 0x137A9DDAF7D714 INVALID 0x5e SMOD 0xe8 0xc4 MLOAD STOP 0x29 ","source":"pragma solidity >=0.4.25 <0.6.0;\n\n/********************************************** RawMatrials ******************************************/\n/// @title RawMatrials\n/// @notice\n/// @dev Create new instance of RawMatrials package\ncontract RawMatrials {\n    /// @notice\n    address Owner;\n\n    enum packageStatus { atcreator, picked, delivered}\n    event ShippmentUpdate(\n        address indexed BatchID,\n        address indexed Shipper,\n        address indexed Manufacturer,\n        uint TransporterType,\n        uint Status\n    );\n    /// @notice\n    address productid;\n    /// @notice\n    bytes32 description;\n    /// @notice\n    bytes32 farmer_name;\n    /// @notice\n    bytes32 location;\n    /// @notice\n    uint quantity;\n    /// @notice\n    address shipper;\n    /// @notice\n    address manufacturer;\n    /// @notice\n    address supplier;\n    /// @notice\n    packageStatus status;\n    /// @notice\n    bytes32 packageReceiverDescription;\n\n    /// @notice\n    /// @dev Intiate New Package of RawMatrials by Supplier\n    /// @param Splr Supplier Ethereum Network Address\n    /// @param Des Description of RawMatrials\n    /// @param FN Farmer Name\n    /// @param Loc Farm Location\n    /// @param Quant Number of units in a package\n    /// @param Shpr Transporter Ethereum Network Address\n    /// @param Rcvr Manufacturer Ethereum Network Address\n    constructor (\n        address Splr,\n        bytes32 Des,\n        bytes32 FN,\n        bytes32 Loc,\n        uint Quant,\n        address Shpr,\n        address Rcvr\n    ) public {\n        Owner = Splr;\n        productid = address(this);\n        description = Des;\n        farmer_name = FN;\n        location = Loc;\n        quantity = Quant;\n        shipper = Shpr;\n        manufacturer = Rcvr;\n        supplier = Splr;\n        status = packageStatus(0);\n    }\n\n    /// @notice\n    /// @dev Get RawMatrials Package Details\n    /// @return Package Details\n    function getSuppliedRawMatrials () public view returns(\n        bytes32 Des,\n        bytes32 FN,\n        bytes32 Loc,\n        uint Quant,\n        address Shpr,\n        address Rcvr,\n        address Splr\n    ) {\n        return(\n            description,\n            farmer_name,\n            location,\n            quantity,\n            shipper,\n            manufacturer,\n            supplier\n        );\n    }\n\n    /// @notice\n    /// @dev Get Package Transaction Status\n    /// @return Package Status\n    function getRawMatrialsStatus() public view returns(\n        uint\n    ) {\n        return uint(status);\n    }\n\n    /// @notice\n    /// @dev Pick Package by Associate Transporter\n    /// @param shpr Transporter Ethereum Network Address\n    function pickPackage(\n        address shpr\n    ) public {\n        require(\n            shpr == shipper,\n            \"Only Associate Shipper can call this function\"\n        );\n        require(\n            status == packageStatus(0),\n            \"Package must be at Supplier.\"\n        );\n        status = packageStatus(1);\n        emit ShippmentUpdate(address(this),shipper,manufacturer,1,1);\n    }\n\n    /// @notice\n    /// @dev Received Package Status Update By Associated Manufacturer\n    /// @param manu Manufacturer Ethereum Network Address\n    function receivedPackage(\n        address manu\n    ) public {\n\n        require(\n            manu == manufacturer,\n            \"Only Associate Manufacturer can call this function\"\n        );\n\n        require(\n            status == packageStatus(1),\n            \"Product not picked up yet\"\n        );\n        status = packageStatus(2);\n        emit ShippmentUpdate(address(this),shipper,manufacturer,1,2);\n    }\n}\n","abiDocs":[{"constant":true,"inputs":[],"name":"getRawMatrialsStatus","outputs":[{"name":"","type":"uint256"}],"payable":false,"stateMutability":"view","type":"function","return":"Package Status","notice":"@dev Get Package Transaction Status","signature":"getRawMatrialsStatus()","signatureHash":"3b205a7d"},{"constant":false,"inputs":[{"name":"manu","type":"address","description":"Manufacturer Ethereum Network Address"}],"name":"receivedPackage","outputs":[],"payable":false,"stateMutability":"nonpayable","type":"function","notice":"@dev Received Package Status Update By Associated Manufacturer","signature":"receivedPackage(address)","signatureHash":"52b99968"},{"constant":false,"inputs":[{"name":"shpr","type":"address","description":"Transporter Ethereum Network Address"}],"name":"pickPackage","outputs":[],"payable":false,"stateMutability":"nonpayable","type":"function","notice":"@dev Pick Package by Associate Transporter","signature":"pickPackage(address)","signatureHash":"638e9a3d"},{"constant":true,"inputs":[],"name":"getSuppliedRawMatrials","outputs":[{"name":"Des","type":"bytes32"},{"name":"FN","type":"bytes32"},{"name":"Loc","type":"bytes32"},{"name":"Quant","type":"uint256"},{"name":"Shpr","type":"address"},{"name":"Rcvr","type":"address"},{"name":"Splr","type":"address"}],"payable":false,"stateMutability":"view","type":"function","return":"Package Details","notice":"@dev Get RawMatrials Package Details","signature":"getSuppliedRawMatrials()","signatureHash":"d02eee23"},{"inputs":[{"name":"Splr","type":"address"},{"name":"Des","type":"bytes32"},{"name":"FN","type":"bytes32"},{"name":"Loc","type":"bytes32"},{"name":"Quant","type":"uint256"},{"name":"Shpr","type":"address"},{"name":"Rcvr","type":"address"}],"payable":false,"stateMutability":"nonpayable","type":"constructor"},{"anonymous":false,"inputs":[{"indexed":true,"name":"BatchID","type":"address"},{"indexed":true,"name":"Shipper","type":"address"},{"indexed":true,"name":"Manufacturer","type":"address"},{"indexed":false,"name":"TransporterType","type":"uint256"},{"indexed":false,"name":"Status","type":"uint256"}],"name":"ShippmentUpdate","type":"event","signature":"ShippmentUpdate(address,address,address,uint256,uint256)","signatureHash":"7e89c4b1"}]}


