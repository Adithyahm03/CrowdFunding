        sender\n        );\n    }\n\n    /// @notice\n    /// @dev Recieved Madicine Batch by Associate Distributer\n    /// @param BatchID Madicine BatchID\n    /// @param Receiver Distributer Ethereum Network Address\n    function recieveWD(\n        address BatchID,\n        address Receiver\n    ) public {\n        require(\n            Receiver == receiver,\n            \"Only Associated receiver can call this function.\"\n        );\n        status = packageStatus(2);\n\n        Madicine(BatchID).recievedWD(\n            Receiver\n        );\n    }\n\n    /// @notice\n    /// @dev Get Madicine Batch Transaction status in between Wholesaler and Distributer\n    /// @return Transaction status\n    function getBatchIDStatus() public view returns(\n        uint\n    ) {\n        return uint(status);\n    }\n\n}\n","abiDocs":[{"constant":false,"inputs":[{"name":"BatchID","type":"address","description":"Madicine BatchID"},{"name":"Shipper","type":"address","description":"Transporter Ethereum Network Address"}],"name":"pickWD","outputs":[],"payable":false,"stateMutability":"nonpayable","type":"function","notice":"@dev Pick Madicine Batch by Associated Transporter","signature":"pickWD(address,address)","signatureHash":"443c28d8"},{"constant":true,"inputs":[],"name":"getBatchIDStatus","outputs":[{"name":"","type":"uint256"}],"payable":false,"stateMutability":"view","type":"function","return":"Transaction status","notice":"@dev Get Madicine Batch Transaction status in between Wholesaler and Distributer","signature":"getBatchIDStatus()","signatureHash":"d2f3fcc7"},{"constant":false,"inputs":[{"name":"BatchID","type":"address","description":"Madicine BatchID"},{"name":"Receiver","type":"address","description":"Distributer Ethereum Network Address"}],"name":"recieveWD","outputs":[],"payable":false,"stateMutability":"nonpayable","type":"function","notice":"@dev Recieved Madicine Batch by Associate Distributer","signature":"recieveWD(address,address)","signatureHash":"f4c07229"},{"inputs":[{"name":"BatchID","type":"address"},{"name":"Sender","type":"address"},{"name":"Shipper","type":"address"},{"name":"Receiver","type":"address"}],"payable":false,"stateMutability":"nonpayable","type":"constructor"}]}


